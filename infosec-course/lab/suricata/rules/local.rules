# ==============================================================================
# SURICATA DETECTION RULES FOR COURSE LABS
# ==============================================================================

# 1. Детект обращения к метаданным облака (IMDS / SSRF)
alert http any any -> any any (msg:"SECURITY-ALERT SSRF Attempt to Cloud Metadata IMDS"; content:"169.254.169.254"; nocase; http_uri; classtype:attempted-admin; sid:2000001; rev:1;)

# 2. Детект попытки SQL Injection (UNION SELECT)
alert http any any -> $HOME_NET any (msg:"SECURITY-ALERT In-Band SQL Injection (UNION SELECT Detected)"; content:"UNION"; nocase; http_uri; content:"SELECT"; nocase; http_uri; classtype:web-application-attack; sid:2000002; rev:1;)

# 3. Детект попытки OS Command Injection (Chained Commands: semicolon / pipe / ampersand)
alert http any any -> $HOME_NET any (msg:"SECURITY-ALERT Command Injection Character Sequence"; pcre:"/(\||;|&|`|\$\()/U"; classtype:web-application-attack; sid:2000003; rev:1;)

# 4. Детект быстрого сканирования портов (Portscan Threshold)
alert tcp any any -> $HOME_NET any (msg:"SECURITY-ALERT TCP SYN Recon Portscan"; flags:S,12; threshold:type both, track by_src, count 15, seconds 5; classtype:attempted-recon; sid:2000004; rev:1;)

# 5. Детект передачи токена со слабым алгоритмом "none"
alert http any any -> $HOME_NET any (msg:"SECURITY-ALERT JWT Algorithm None Exploitation Attempt"; content:"eyJhbGciOiJub25l"; nocase; http_header; classtype:attempted-user; sid:2000005; rev:1;)
